generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  checkSessions CheckSession[]
  progress      Progress?
  badges        UserBadge[]
}

enum ErrorStatus {
  PENDING
  ACCEPTED
  IGNORED
}

model CheckSession {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalText String          @db.Text
  wordCount    Int
  errorCount   Int             @default(0)
  pointsEarned Int             @default(0)
  createdAt    DateTime        @default(now())
  errors       DetectedError[]
}

model DetectedError {
  id                   String       @id @default(cuid())
  checkSessionId       String
  checkSession         CheckSession @relation(fields: [checkSessionId], references: [id], onDelete: Cascade)
  offset               Int
  length               Int
  originalSpan         String
  suggestedReplacement String
  category             String
  ruleId               String?
  explanation          String?      @db.Text
  pronunciationGuide   String?
  status               ErrorStatus  @default(PENDING)
  reviewedAt           DateTime?
  createdAt            DateTime     @default(now())
}

model Progress {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore          Int       @default(0)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastCheckDate       DateTime?
  totalSessionsCount  Int       @default(0)
  totalErrorsReviewed Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}

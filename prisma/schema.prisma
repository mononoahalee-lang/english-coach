generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  authSessions  Session[]
  checkSessions CheckSession[]
  progress      Progress?
  badges        UserBadge[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ErrorStatus {
  PENDING
  ACCEPTED
  IGNORED
}

model CheckSession {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalText String          @db.Text
  wordCount    Int
  errorCount   Int             @default(0)
  pointsEarned Int             @default(0)
  createdAt    DateTime        @default(now())
  errors       DetectedError[]
}

model DetectedError {
  id                   String       @id @default(cuid())
  checkSessionId       String
  checkSession         CheckSession @relation(fields: [checkSessionId], references: [id], onDelete: Cascade)
  offset               Int
  length               Int
  originalSpan         String
  suggestedReplacement String
  category             String
  ruleId               String?
  explanation          String?      @db.Text
  pronunciationGuide   String?
  status               ErrorStatus  @default(PENDING)
  reviewedAt           DateTime?
  createdAt            DateTime     @default(now())
}

model Progress {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore          Int       @default(0)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastCheckDate       DateTime?
  totalSessionsCount  Int       @default(0)
  totalErrorsReviewed Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}
